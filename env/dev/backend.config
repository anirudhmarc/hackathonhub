# ============================================================================
# Development Backend Configuration (us-east-1)
# ============================================================================
# Isolated from prod by a distinct state key. Reuses the same state bucket and
# DynamoDB lock table (account-global) — the different key is full isolation.
#
# Usage:
#   terraform init -reconfigure -backend-config=env/dev/backend.config
#   terraform apply -var-file=env/dev/dev.tfvars
# ============================================================================

bucket         = "deepgram-pipecat-aws-tfstate-152839701197"
key            = "deepgram-pipecat-aws/dev/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "deepgram-pipecat-aws-tflock"
