# Terraform provider binaries (too large for GitHub)
.terraform/providers/

# Terraform state backup files
terraform.tfstate.backup
.terraform.tfstate.lock.info

# Sensitive files
.env
*.pem
*.key
terraform.tfvars
*.tfvars
env/**/*.tfvars
terraform.tfstate

# Terraform backend config — the bucket name embeds an AWS ACCOUNT ID, so this
# is per-account and must not be committed. Generate yours with:
#   ./bootstrap-backend.sh <dev|prod>
# The committed env/**/backend.config.example templates are the source of truth.
env/**/backend.config
!env/**/backend.config.example

# Participant PII / credential exports — never commit
participants.csv
participant_credentials.csv
*credentials*.csv

# Saved Terraform plan files (binary, transient)
tfplan
tfplan.*
*.tfplan

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
.gstack/
lambda-code/layers/tenancy_layer.zip
