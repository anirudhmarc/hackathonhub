# ============================================================================
# Production Backend Configuration — TEMPLATE (us-east-1)
# ============================================================================
# The real `backend.config` is gitignored because the bucket name embeds an AWS
# ACCOUNT ID. See env/dev/backend.config.example for the full explanation.
#
# Setup:
#   ./bootstrap-backend.sh prod
#
# Then:
#   terraform init -reconfigure -backend-config=env/prod/backend.config
#   terraform apply -var-file=env/prod/prod.tfvars   # create prod.tfvars locally
#
# Shares the bucket + lock table with dev; isolated by a distinct state KEY.
# ============================================================================

bucket         = "hackhub-tfstate-<ACCOUNT_ID>"
key            = "hackhub/prod/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "hackhub-tflock"
