# ============================================================================
# Production Backend Configuration
# ============================================================================
# This file configures where Terraform stores its state file
# 
# Usage:
#   terraform init -backend-config=env/prod/backend.config
# ============================================================================

bucket         = "hackhub-terraform-state-prod"
key            = "hackhub/prod/terraform.tfstate"
region         = "ap-southeast-1"
encrypt        = true
dynamodb_table = "hackhub-terraform-lock-prod"

# Optional: Enable versioning for state file recovery
# versioning     = true
